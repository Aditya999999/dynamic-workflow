{
  "version": "1.0.0",
  "agents": [
    {
      "agent_id": "business-analyst",
      "display_name": "Business Analyst Agent",
      "contract_version": "1.0.0",
      "purpose": "Requirements analysis, BRD generation, and user story elaboration",
      "capabilities": [
        "requirements_analysis",
        "brd_generation",
        "user_stories",
        "synopsis",
        "feedback_incorporation",
        "jira_query",
        "kb_query"
      ],
      "supported_task_types": [
        "create_brd",
        "create_user_stories",
        "dynamic_workflow_ba_task",
        "handle_ba_message",
        "get_synopsis",
        "edit_synopsis",
        "jira_agent"
      ],
      "status": "active",
      "contract_status": "verified",
      "invocation_enabled": true,
      "deployment_type": "http",
      "authentication_scheme": "bearer_jwt",
      "environment_bindings": {
        "local": {
          "base_url": "${BA_AGENT_BASE_URL}"
        },
        "office": {
          "base_url": "${BA_AGENT_BASE_URL}"
        }
      },
      "endpoints": {
        "task": [
          {
            "name": "dynamic_workflow_ba_task",
            "route": "/dynamic-workflow/ba-task",
            "method": "POST",
            "category": "task",
            "request_schema": {
              "type": "object",
              "properties": {
                "prompt": { "type": "string" },
                "workspace_id": { "type": "string" },
                "conversation_id": { "type": "string" },
                "dry_run": { "type": "boolean" }
              },
              "required": ["prompt"]
            },
            "response_schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "data": { "type": "object" }
              }
            },
            "timeout_seconds": 90,
            "async_supported": false,
            "auth_scheme": "bearer_jwt",
            "enabled": true
          },
          {
            "name": "create_user_stories",
            "route": "/create-user-stories",
            "method": "POST",
            "category": "task",
            "request_schema": {
              "type": "object",
              "properties": {
                "user_message": { "type": "string" },
                "workspace_id": { "type": "string" },
                "conversation_id": { "type": "string" }
              },
              "required": ["user_message"]
            },
            "response_schema": {
              "type": "object"
            },
            "timeout_seconds": 60,
            "async_supported": false,
            "auth_scheme": "bearer_jwt",
            "enabled": true
          },
          {
            "name": "handle_ba_message",
            "route": "/handle-ba-message",
            "method": "POST",
            "category": "task",
            "timeout_seconds": 60,
            "enabled": true
          }
        ],
        "lifecycle": [
          { "name": "health_check", "route": "/health", "method": "GET", "category": "lifecycle", "enabled": true },
          { "name": "create_session", "route": "/create-session", "method": "POST", "category": "lifecycle", "enabled": true },
          { "name": "store_conversation", "route": "/store-conversation", "method": "POST", "category": "lifecycle", "enabled": true },
          { "name": "get_conversation", "route": "/get-conversation", "method": "POST", "category": "lifecycle", "enabled": true },
          { "name": "delete_conversation", "route": "/delete-conversation", "method": "POST", "category": "lifecycle", "enabled": true }
        ],
        "admin": [
          { "name": "get_config", "route": "/get-config", "method": "GET", "category": "admin", "enabled": true },
          { "name": "update_config", "route": "/update-config", "method": "POST", "category": "admin", "enabled": true },
          { "name": "test_jira_connection", "route": "/test-jira-connection", "method": "POST", "category": "admin", "enabled": true }
        ]
      }
    },
