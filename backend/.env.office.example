APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

DEEP_AGENT_MODEL=gpt-4o
DEEP_AGENT_MODEL_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://forge-openai-eastus2.openai.azure.com/
AZURE_OPENAI_API_KEY=office_managed_identity_or_key
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

MONGODB_URI=mongodb://cosmos-mongodb-dwf.mongo.cosmos.azure.com:10255/?ssl=true
MONGODB_DATABASE=dwf_orchestrator
PERSISTENCE_MODE=mongo

JWT_SECRET=office_production_secret_key_from_keyvault
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

DWF_AGENT_REGISTRY_PATH=registry/agents.json
DWF_MAX_REPLAN_ITERATIONS=6
DWF_MAX_TOTAL_AGENT_INVOCATIONS=30
DWF_MAX_AGENT_REINVOCATIONS=3
DWF_MAX_WORKFLOW_NODES=50
DWF_MAX_WORKFLOW_DURATION_SECONDS=3600
DWF_ARTIFACT_INLINE_MAX_BYTES=2048

DWF_EVENT_HEARTBEAT_SECONDS=30
DWF_EVENT_REPLAY_HOURS=24

AGENT_MODE=live

BA_AGENT_BASE_URL=https://forgeX-dev-fun-ba.azurewebsites.net/api
ARCHITECT_AGENT_BASE_URL=https://arch-rest-dev.azurewebsites.net/api
DEVELOPER_AGENT_BASE_URL=https://forgeX-dev-fun-devagent-ejaxe3acdmgdfthu.eastus2-01.azurewebsites.net/api
PO_AGENT_BASE_URL=https://po-agent-dev.azurewebsites.net/api
QE_AGENT_BASE_URL=https://qe-agent-dev.azurewebsites.net/api
