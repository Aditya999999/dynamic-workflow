# Dynamic Workflow Orchestrator Backend Configuration
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Deep Agent LLM Configuration (Optional - falls back to deterministic planning engine if not set)
DEEP_AGENT_MODEL=gpt-4o
DEEP_AGENT_MODEL_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# MongoDB Persistence
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=dwf_orchestrator
PERSISTENCE_MODE=auto # auto: use Mongo if reachable, otherwise in-memory mock store

# Security / JWT
JWT_SECRET=dwf_super_secret_local_dev_jwt_key_32bytes_min_length_1234
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=86400

# Registry & Guardrail Limits
DWF_AGENT_REGISTRY_PATH=registry/agents.json
DWF_MAX_REPLAN_ITERATIONS=6
DWF_MAX_TOTAL_AGENT_INVOCATIONS=30
DWF_MAX_AGENT_REINVOCATIONS=3
DWF_MAX_WORKFLOW_NODES=50
DWF_MAX_WORKFLOW_DURATION_SECONDS=3600
DWF_ARTIFACT_INLINE_MAX_BYTES=2048

# Event Streaming
DWF_EVENT_HEARTBEAT_SECONDS=15
DWF_EVENT_REPLAY_HOURS=24

# Agent Execution Mode (mock | live)
AGENT_MODE=mock

# Agent Base URLs (Used in live mode or external HTTP mock mode)
BA_AGENT_BASE_URL=http://localhost:7101/api
ARCHITECT_AGENT_BASE_URL=http://localhost:7102/api
DEVELOPER_AGENT_BASE_URL=http://localhost:7103/api
PO_AGENT_BASE_URL=http://localhost:7104/api
QE_AGENT_BASE_URL=http://localhost:7105/api
